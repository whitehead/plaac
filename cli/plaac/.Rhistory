source("plaac_plot_util.r")
if (length(args) < 1) {
cat("usage: Rscript plaac_plot.r plotdata.txt [-d]\n")
cat("   where plotdata.txt is the output of the Java program plaac with the -p option,\n")
cat("   and optional flag -d plots doubly-smoothed rather than singly-smoothed curves.\n")
cat("See sourcecode of plaac_plot_util.r and plaac_plot.r for other plot options.\n")
} else if (length(args)>1 && args[2]=="-d") {
plot_genes(args[1], outfile="plaac_plots_single.png", showSeq=T, showHMMProbs=T, showParses=T,
seqUnderline=c("PLAACx2"), seqColor="COMBO",
tracks=c("FIx2","PLAACx2","PAPAx2","THRESH"), w=41)
